# Zerodha Kite. Do not commit real credentials.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Application behaviour
NICE_LOG_LEVEL=INFO
NICE_DASHBOARD_REFRESH_MS=500
NICE_PAPER_TRADING_ONLY=true
NICE_OPTION_STRIKES_EACH_SIDE=5
# Default: subscribe to every CE/PE strike in the nearest active expiry.
# Use atm_window only for lower-bandwidth diagnostic testing.
NICE_OPTION_CHAIN_SCOPE=full_current_expiry

# Controlled paper-forward test based on the selected 308-session NIFTY core
# candidate. This remains paper-only and never enables broker order placement.
NICE_FORWARD_TEST_ENABLED=true
NICE_FORWARD_TEST_POLICY_ID=NIFTY_CORE_308D_V1

# Verify tokens against the current Kite instrument master before each live session.
NICE_SUBSCRIPTIONS=NSE:NIFTY 50:256265,BSE:SENSEX:265
